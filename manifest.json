{
    "manifest_version": 3,
    "name": "__MSG_ext_name__",
    "short_name": "Zebu",
    "description": "__MSG_ext_description__",
    "default_locale": "en",
    "version": "0.2.0",
    "minimum_chrome_version": "120",
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_title": "Zebu",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png"
        }
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["storage", "alarms", "scripting", "activeTab", "contextMenus"],
    "host_permissions": ["https://*.zebu.work/*"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+Z"
            },
            "description": "__MSG_command_open_popup__"
        },
        "toggle-timer": {
            "suggested_key": {
                "default": "Alt+Shift+S"
            },
            "description": "__MSG_command_toggle_timer__"
        },
        "new-timer": {
            "suggested_key": {
                "default": "Alt+Shift+N"
            },
            "description": "__MSG_command_new_timer__"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://github.com/*",
                "https://gitlab.com/*",
                "https://*.atlassian.net/*",
                "https://linear.app/*",
                "https://app.asana.com/*",
                "https://trello.com/*",
                "https://bitbucket.org/*",
                "https://app.clickup.com/*",
                "https://*.basecamp.com/*"
            ],
            "js": ["content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        }
    ]
}
